# Database (PostgreSQL - Neon / Supabase / any managed Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/mnbm?schema=public"

# Auth
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example.com"

# Email (SMTP)
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey-or-username"
EMAIL_SERVER_PASSWORD="smtp-password"
CONTACT_EMAIL="enquiries@example.com"

# Public site config
NEXT_PUBLIC_SITE_URL="https://www.example.com"
NEXT_PUBLIC_PHONE="+91-9999999999"
NEXT_PUBLIC_WHATSAPP="919999999999"
NEXT_PUBLIC_BUSINESS_NAME="Your Business Name"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# Spam protection (optional - Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
